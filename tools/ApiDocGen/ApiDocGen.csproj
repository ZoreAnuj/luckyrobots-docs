<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LuckyEngine.ApiDocGen</RootNamespace>
    <AssemblyName>apidocgen</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pure syntactic parse of the engine's .cs files. No compilation, no
         dependency resolution (Coral / gRPC / etc.) required. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

  <!-- Ship the default config next to the binary so the tool is runnable from anywhere. -->
  <ItemGroup>
    <None Include="apidocgen.config.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
